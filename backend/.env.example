# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# SQLite by default. For Postgres use e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db
# Comma-separated list of allowed frontend origins (use * while testing)
CORS_ORIGINS=*
